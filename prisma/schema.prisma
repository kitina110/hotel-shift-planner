generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Provozní pokrytí (jádro domény) ───────────────────────────────────────

model OperationalZone {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intervals          CoverageInterval[]
  shiftTypes         ShiftType[]
  zoneQualifications EmployeeZoneQualification[]
}

model CoverageInterval {
  id        String  @id @default(cuid())
  zoneId    String
  label     String?
  startTime String
  endTime   String
  sortOrder Int     @default(0)

  zone  OperationalZone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rules CoverageRequirementRule[]

  @@index([zoneId, sortOrder])
}

model CoverageRequirementRule {
  id         String @id @default(cuid())
  intervalId String
  minGuests  Int
  maxGuests  Int?
  staffCount Int

  interval CoverageInterval @relation(fields: [intervalId], references: [id], onDelete: Cascade)

  @@index([intervalId, minGuests])
}

// ─── Provozní kontext (profil poptávky) ────────────────────────────────────

model DemandProfile {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guestForecasts GuestForecast[]
}

// ─── Směny (prostředek pokrytí) ────────────────────────────────────────────

model ShiftType {
  id              String   @id @default(cuid())
  name            String
  durationMinutes Int
  breakMinutes    Int
  startTime       String
  endTime         String   @default("22:00")
  zoneId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  zone            OperationalZone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  qualifications  EmployeeQualification[]
  assignments     ScheduleAssignment[]
  staffingRules   StaffingRule[]
}

// ─── Zaměstnanci (Employee 2.0) ────────────────────────────────────────────

enum AvailabilityStatus {
  AVAILABLE
  PREFERRED_OFF
  UNAVAILABLE
  VACATION
  SICK
}

model Employee {
  id                             String   @id @default(cuid())
  name                           String
  sortOrder                      Int      @default(0)
  isActive                       Boolean  @default(true)
  contractHoursPerWeek           Float
  isTemporaryHelp                Boolean  @default(false)
  useDefaultAvailabilityTemplate Boolean  @default(false)
  /// Rezervováno — v1 se nezobrazuje v UI ani v generátoru.
  maxConsecutiveDays             Int      @default(6)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  qualifications              EmployeeQualification[]
  zoneQualifications          EmployeeZoneQualification[]
  defaultAvailabilityTemplate EmployeeDefaultAvailability[]
  weeklyAvailabilities        EmployeeWeeklyAvailability[]
  /// @deprecated Odstranění v E8 — dočasně pro zpětnou kompatibilitu.
  availabilities              Availability[]
  assignments                 ScheduleAssignment[]

  @@index([sortOrder])
}

model EmployeeQualification {
  id          String @id @default(cuid())
  employeeId  String
  shiftTypeId String

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftType ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, shiftTypeId])
}

/// @deprecated Odstranění v E8 — nahrazeno kvalifikací na úrovni směny.
model EmployeeZoneQualification {
  id         String @id @default(cuid())
  employeeId String
  zoneId     String

  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  zone     OperationalZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([employeeId, zoneId])
}

/// Výchozí týdenní šablona dostupnosti (dlouhodobá, volitelná).
model EmployeeDefaultAvailability {
  id         String             @id @default(cuid())
  employeeId String
  dayOfWeek  Int
  status     AvailabilityStatus @default(AVAILABLE)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
}

/// Týdenní dostupnost vázaná na konkrétní rozpis (Schedule).
model EmployeeWeeklyAvailability {
  id         String             @id @default(cuid())
  scheduleId String
  employeeId String
  date       DateTime
  status     AvailabilityStatus @default(AVAILABLE)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, employeeId, date])
  @@index([scheduleId, date])
}

/// @deprecated Odstranění v E8 — nahrazeno EmployeeDefaultAvailability + EmployeeWeeklyAvailability.
model Availability {
  id           String  @id @default(cuid())
  employeeId   String
  dayOfWeek    Int
  available    Boolean @default(true)
  preferredOff Boolean @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
}

// ─── Legacy: pravidla obsazenosti vázaná na směnu (odstranění v etapě 7) ───

model StaffingRule {
  id          String @id @default(cuid())
  shiftTypeId String
  minGuests   Int
  maxGuests   Int?
  staffCount  Int

  shiftType ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)

  @@index([shiftTypeId, minGuests])
}

// ─── Týdenní plán ─────────────────────────────────────────────────────────

model Schedule {
  id        String   @id @default(cuid())
  weekStart DateTime
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guestForecasts       GuestForecast[]
  assignments          ScheduleAssignment[]
  weeklyAvailabilities EmployeeWeeklyAvailability[]

  @@unique([weekStart])
}

model GuestForecast {
  id              String  @id @default(cuid())
  scheduleId      String
  date            DateTime
  guestCount      Int
  demandProfileId String?
  notes           String?

  schedule      Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  demandProfile DemandProfile? @relation(fields: [demandProfileId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, date])
}

model ScheduleAssignment {
  id          String   @id @default(cuid())
  scheduleId  String
  employeeId  String
  shiftTypeId String
  date        DateTime

  schedule  Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id])
  shiftType ShiftType @relation(fields: [shiftTypeId], references: [id])

  @@unique([scheduleId, employeeId, date])
  @@index([scheduleId, date])
}
